{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.local/share/fastfetch/ascii/cat.txt",
        "type": "auto",
        "height": 18,
        "padding": {
            "top": 8,
            "right": 6,
            "left": 2
        }
//	"color": {
//	"1": "38;5;198"
//	}
    },
    "display": {
        //"separator": " ⊣> ",
        "separator": " // ",
	"color": {
	"separator": "bold_white"
    },
    "bar": {
        "width": 10,       // Width of percentage bars
        "charelapsed": "■", // Character for elapsed portion
        "chartotal": "-"   // Character for total portion
    },
    "percent": {
        "type": 9,         // 1=number, 2=bar, 3=both, 9=colored number
        "color": {
            "green": "green",
            "yellow": "yellow",
            "red": "red"
        }
    }
},
    "modules": [
	"break",
	"break",
	{
            "type": "title",
	          "format": "{#38;5;117}[{user-name}] {#bold_magenta}> {#38;5;117}[{host-name}]",
	          "keyWidth": 10
        },
        "break",
      	{
            "type": "os",
            //"key": " ",
            "keyColor": "red"
        },
        {
            "type": "host",
            //"key": " ",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            //"key": " ",
            "keyColor": "red"
        },
      	{
            "type": "bios",
            //"key": " ",
            "keyColor": "red"
        },
        {
            "type": "packages",
            //"key": "󰏖 ",
            "keyColor": "red"
        },
        {
            "type": "shell",
            //"key": " ",
            "keyColor": "red"
        },
	"break",
        {
            "type": "monitor",
            //"key": " ",
            "keyColor": "34",
            "format": "{width}x{height}, {refresh-rate} Hz"
            //"format": "{width}x{height} in {inch}\", {refresh-rate} Hz"
	      },
        {
        "type": "de",
        //"key": " ",
        "keyColor": "34"
        },
        {
            "type": "wm",
            //"key": " ",
            "keyColor": "34"
        },
        {
            "type": "wmtheme",
            //"key": "󰉼 ",
            "keyColor": "34"
        },
        {
            "type": "icons",
            //"key": "󰀻 ",
            "keyColor": "34"
        },
      	{
	    "type": "terminal",
            //"key": " ",
            "keyColor": "34"
        },
        {
            "type": "terminalfont",
            //"key": " ",
            "keyColor": "34"
	      },
	"break",
        {   "type": "cpu",
            //"key": " ",
            "keyColor": "38;5;202"
        },
        {
            "type": "gpu",
            //"key": "󰢮 ",
            "keyColor": "38;5;202",
            "format": "{vendor} {name}"
        },
        {
            "type": "memory",
            //"key": " ",
            "keyColor": "38;5;202"
        },
        {
            "type": "swap",
            //"key": "󰓡 ",
            "keyColor": "38;5;202"
        },
        {
            "type": "disk",
            //"key": "󰋊 ",
            "keyColor": "38;5;202",
            "folders": ["/", "/home"],
            "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
        },
        {
            "type": "localip",
            //"key": "🖧 ",
            "keyColor": "38;5;202"
        },
	"break",
        {
            "type": "uptime",
            //"key": " ",
            "keyColor": "35"
        },
        {
            "type": "command",
            "key": "Birth",
            //"key": "⧖ ",
            "keyColor": "35",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "datetime",
            //"key": "⧗ ",
            "keyColor": "35"
        },
	"break",
        {
            "type": "media",
            //"key": "󰝚 ",
            "keyColor": "35"
        },
	"break",
	      {
	          "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
      	},
	"break"
    ]
}
